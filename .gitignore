# Large binary data files
*.rds
*.h5ad
*.pkl
*.links


# TF-family enrichment: figures are regenerated by the scripts; only tables are tracked
scripts_and_inputs/Analysis/CellOracle_GRN_analysis/outputs/TF_family_enrichment/*.pdf
scripts_and_inputs/Analysis/CellOracle_GRN_analysis/outputs/TF_family_enrichment/*.png

# Expression_plots: figures are regenerated by build.py; only tables, source data and build.json are tracked
scripts_and_inputs/Analysis/Expression_plots/output/figures/
__pycache__/

# Figure kit (Fig. 1, Fig. 5a,b): figures and verification reports are regenerated; fonts are licensed and never committed
scripts_and_inputs/Analysis/Figure_kit/output/
scripts_and_inputs/Analysis/Figure_kit/provenance/
*.ttf
*.TTF
# Wet-lab figures: only the Source Data workbook itself is committed (lab GitLab only, see GITHUB_EXCLUDE.txt); everything derived from it is regenerated
scripts_and_inputs/Analysis/Figure_kit/source_data/*
!scripts_and_inputs/Analysis/Figure_kit/source_data/Source data-20261118.xlsx
# Figure kit, wet-lab figures: measurement tables are regenerated from the Source Data (tools/fig*_tables.py) and the
# original images are not distributed (tools/make_placeholder_tiles.py writes blank tiles; the colour keys are kept)
scripts_and_inputs/Analysis/Figure_kit/data/fig2/fig2[dfg]_*[a-z0-9].csv
!scripts_and_inputs/Analysis/Figure_kit/data/fig2/*_stats.csv
scripts_and_inputs/Analysis/Figure_kit/data/fig3/fig3[bdg]_*.csv
!scripts_and_inputs/Analysis/Figure_kit/data/fig3/*_stats.csv
scripts_and_inputs/Analysis/Figure_kit/data/fig4/fig4[bdeg]_*.csv
!scripts_and_inputs/Analysis/Figure_kit/data/fig4/*_stats.csv
!scripts_and_inputs/Analysis/Figure_kit/data/fig4/fig4e_ratios.csv
scripts_and_inputs/Analysis/Figure_kit/data/fig5/fig5d_luc.csv
scripts_and_inputs/Analysis/Figure_kit/data/fig5/fig5d_luc_wells.csv
scripts_and_inputs/Analysis/Figure_kit/data/fig5/fig5d_luc_rep_map.csv
scripts_and_inputs/Analysis/Figure_kit/data/fig6/fig6[adeg]_*.csv
!scripts_and_inputs/Analysis/Figure_kit/data/fig6/*_stats.csv
